# Copy to .env for local dev (netlify dev reads it). In production set these in
# Netlify → Site configuration → Environment variables.

# --- Public: bundled into the browser (safe by design; RLS protects the data) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only: used by Netlify Functions, never exposed to the browser ---
SITE_URL=http://localhost:8888
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# e.g. claude-opus-5-5. Current models reject temperature≠1, so temperature 0
# is only sent to older models that accept it (see README).
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (cost vs. thoroughness)
LLM_EFFORT=medium
# "default" = server-side retry on another model if a request is declined; "off" to disable
LLM_FALLBACKS=default

STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

# Random long string; used to hash anonymous IPs for rate limiting
ANON_HASH_SALT=
