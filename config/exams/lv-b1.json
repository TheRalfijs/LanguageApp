            { "band": 1, "min": 1, "max": 1, "descriptor": "Frequent basic errors; meaning sometimes unclear." },
            { "band": 2, "min": 2, "max": 2, "descriptor": "Some errors, but meaning is clear." },
            { "band": 3, "min": 3, "max": 3, "descriptor": "Good control of simple structures; few errors." }
          ]
        }
      ]
